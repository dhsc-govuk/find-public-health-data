{
  "name": "@fphd/web-server",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/host.ts",
      "types": "./src/host.ts",
      "default": "./dist/host.js"
    },
    "./api-client": {
      "development": "./src/api-client.ts",
      "types": "./src/api-client.ts",
      "default": "./dist/api-client.js"
    },
    "./api-context": {
      "development": "./src/api-context.ts",
      "types": "./src/api-context.ts",
      "default": "./dist/api-context.js"
    },
    "./entry-server": {
      "development": "./src/entry-server.tsx",
      "types": "./src/entry-server.tsx",
      "default": "./dist/entry-server.js"
    },
    "./flash": {
      "development": "./src/flash.ts",
      "types": "./src/flash.ts",
      "default": "./dist/flash.js"
    },
    "./fake-auth": {
      "development": "./src/fake-auth.ts",
      "types": "./src/fake-auth.ts",
      "default": "./dist/fake-auth.js"
    },
    "./fake-auth-react-router": {
      "development": "./src/fake-auth-react-router-app.ts",
      "types": "./src/fake-auth-react-router-app.ts",
      "default": "./dist/fake-auth-react-router-app.js"
    },
    "./logger-context": {
      "development": "./src/logger-context.ts",
      "types": "./src/logger-context.ts",
      "default": "./dist/logger-context.js"
    },
    "./page-url": {
      "development": "./src/page-url.ts",
      "types": "./src/page-url.ts",
      "default": "./dist/page-url.js"
    },
    "./react-router": {
      "development": "./src/react-router-app.ts",
      "types": "./src/react-router-app.ts",
      "default": "./dist/react-router-app.js"
    },
    "./request-id-headers": {
      "development": "./src/request-id-headers.ts",
      "types": "./src/request-id-headers.ts",
      "default": "./dist/request-id-headers.js"
    },
    "./session": {
      "development": "./src/session.ts",
      "types": "./src/session.ts",
      "default": "./dist/session.js"
    },
    "./testing": {
      "development": "./src/testing.ts",
      "types": "./src/testing.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "!dist/testing.js"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fphd/auth": "workspace:*",
    "@fphd/config": "workspace:*",
    "@fphd/express": "workspace:*",
    "@fphd/logger": "workspace:*",
    "@react-router/express": "catalog:",
    "@react-router/node": "catalog:",
    "basic-auth": "catalog:",
    "compression": "catalog:",
    "express": "catalog:",
    "isbot": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@fphd/ui": "workspace:*",
    "@types/compression": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
