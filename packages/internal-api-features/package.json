{
  "name": "@fphd/internal-api-features",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "development": "./src/contract.ts",
      "types": "./src/contract.ts",
      "default": "./dist/contract.js"
    },
    "./testing": {
      "development": "./src/testing.ts",
      "types": "./src/testing.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "!dist/testing.js"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/busboy": "catalog:",
    "@fphd/api-server": "workspace:*",
    "@fphd/auth": "workspace:*",
    "@fphd/config": "workspace:*",
    "@fphd/db": "workspace:*",
    "@fphd/internal-storage": "workspace:*",
    "@fphd/utils": "workspace:*",
    "csv-parse": "catalog:",
    "drizzle-orm": "catalog:",
    "express": "catalog:",
    "postgres": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@azure/storage-blob": "catalog:",
    "@fphd/express": "workspace:*",
    "@fphd/logger": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
