{
  "name": "@fphd/db-operations",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./data-migration-contract": {
      "development": "./src/data-migration-contract.ts",
      "types": "./src/data-migration-contract.ts",
      "default": "./dist/data-migration-contract.js"
    },
    "./testing": {
      "development": "./src/testing.ts",
      "types": "./src/testing.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "!dist/testing.js",
    "drizzle/*.sql",
    "drizzle/meta/_journal.json",
    "data",
    "!data/seed/export"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fphd/config": "workspace:*",
    "@fphd/db": "workspace:*",
    "@fphd/internal-read-models": "workspace:*",
    "@fphd/utils": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@fphd/auth": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
