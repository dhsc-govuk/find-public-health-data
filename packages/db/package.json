{
  "name": "@fphd/db",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./audit-log": {
      "development": "./src/audit-log.ts",
      "types": "./src/audit-log.ts",
      "default": "./dist/audit-log.js"
    },
    "./testing": {
      "development": "./src/testing.ts",
      "types": "./src/testing.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "!dist/testing.js",
    "!dist/scripts"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/identity": "catalog:",
    "@fphd/config": "workspace:*",
    "@fphd/utils": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
