{
  "name": "@fphd/beta-access",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./context": {
      "development": "./src/context.ts",
      "types": "./src/context.ts",
      "default": "./dist/context.js"
    },
    "./gate": {
      "development": "./src/gate.ts",
      "types": "./src/gate.ts",
      "default": "./dist/gate.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/communication-email": "catalog:",
    "@azure/identity": "catalog:",
    "@fphd/auth": "workspace:*",
    "@fphd/config": "workspace:*",
    "@fphd/web-server": "workspace:*",
    "jose": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
