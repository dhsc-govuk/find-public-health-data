# Local development environment. Copy to `.env` and adjust as needed.
# `.env` is gitignored; this example is committed.
# The dev scripts load this file automatically (--env-file-if-exists); in deployed
# environments every value is injected by the platform instead.

# Deployment environment: local | test | dev | preview | production. Required, with no
# default anywhere: every fallback keyed off it relaxes something when the environment is
# this machine, so an unset value must not be allowed to pick that silently. `test` is set
# by the test scripts, not here.
APP_ENV=local

# Per-app listen address and port. Defaults: host 0.0.0.0; public-web 3000,
# internal-web 3001, public-api 4000, internal-api 4001, internal-worker 4002. The
# internal worker serves only its /livez and /readyz probes on its port. A PORT set
# here applies to every app that loads this file, so leave it unset unless you are
# running one app.
#HOST=0.0.0.0
#PORT=4000

# Base URL each web app's server uses to call its API. Defaults: public-web
# http://localhost:4000, internal-web http://localhost:4001.
#API_URL=http://localhost:4000

# How long internal-web waits for internal-api to answer a data table upload, counted from when
# the file has been sent (default 50000). Keep it under Front Door's 60-second origin timeout, so
# the upload page's own message shows rather than Front Door's error.
#API_UPLOAD_TIMEOUT_MS=50000

# How long a server keeps serving after SIGTERM before it closes anything, giving the platform
# time to stop routing new requests to it. Defaults to 0 where nothing routes to the process
# (APP_ENV local or test) and 5000 elsewhere. Comes out of the budget below, so it must be under
# it.
#SHUTDOWN_DRAIN_MS=5000

# The budget for a whole stop, drain included (default 25000). It is a ceiling, not a wait: a
# stop with nothing in flight ends as soon as the drain does. Keep it under the platform's own
# grace period — Container Apps allows 30s by default — and raise the two together, never this
# one alone.
#SHUTDOWN_GRACE_PERIOD_MS=25000

# The commit a server was built from, which it logs with `Listening` (default unknown). The
# production images set it from their REVISION build arg; leave it unset here.
#REVISION=

# Proxies between the browser and each web app whose X-Forwarded-* headers are trusted for the
# request's host, protocol and client address (default 2: Front Door, then Container Apps
# ingress). Change it with the ingress, not the app; 0 trusts none.
#TRUSTED_PROXY_HOPS=2

# Logging. LOG_LEVEL: fatal | error | warn | info | debug | trace. Defaults to info when
# APP_ENV is production or preview, debug otherwise.
# Pretty printing applies only when APP_ENV is local (on by default; LOG_PRETTY=0 disables).
# Deployed environments always log JSON.
# Pretty output prints each request as one line; LOG_REQUEST_DETAILS=1 prints its req and res
# objects in full instead. JSON output always carries them.
#LOG_LEVEL=debug
#LOG_PRETTY=0
#LOG_REQUEST_DETAILS=1

# Signs JWT session cookies issued by the authentication backend. This value is for local
# development only; inject a secret of at least 32 bytes when deploying. Services that verify
# the same audience's session must share one value — the internal web app forwards its session
# cookie to the internal API, which verifies it with this secret — so inject one value per
# audience, not one per service.
SESSION_JWT_SECRET=fphd-local-development-jwt-secret-change-before-deploying

# Signs internal-web's own cookie session, which today carries flash messages across a
# redirect. Separate from SESSION_JWT_SECRET so the two rotate independently. Local value
# only; at least 32 bytes.
WEB_SESSION_SECRET=fphd-local-development-web-session-secret-change-before-deploying

# HTTP basic auth in front of each web app, keeping it private before launch. On when both are
# set, off when both are unset; setting only one is a startup error. /livez and /readyz stay open
# for the platform's probes. The username must not contain a colon.
#BASIC_AUTH_USERNAME=fphd
#BASIC_AUTH_PASSWORD=

# Private beta access in front of public-web: only the invitees listed can use it, each signing in
# with a link emailed to them that works for 15 minutes. On when BETA_ACCESS_INVITEES is set, a JSON
# array of {"email", "label"}; the label names the invitee in the logs instead of their address.
# BETA_ACCESS_ENDS_AT (ISO 8601 with an offset), BETA_ACCESS_SECRET (at least 32 bytes) and
# SITE_URL (the address the links point at) are then required. It cannot be on with basic auth.
# Without EMAIL_ENDPOINT, which only APP_ENV local and test allow, the page shows each link instead
# of emailing it. Local values only.
BETA_ACCESS_INVITEES='[{"email":"developer@example.com","label":"Local development"}]'
BETA_ACCESS_ENDS_AT=2099-12-31T23:59:59Z
BETA_ACCESS_SECRET=fphd-local-development-beta-access-secret-change-before-deploying
SITE_URL=http://localhost:3000

# Azure Communication Services, which emails the sign-in links when deployed. public-web signs in
# to it as the managed identity AZURE_CLIENT_ID names. Set both or neither.
#EMAIL_ENDPOINT=https://<resource>.uk.communication.azure.com
#EMAIL_SENDER_ADDRESS=no-reply@<sending domain>

# Database connection, shared by all roles.
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=fphd

# TLS to the database. Left unset it follows APP_ENV: off for local and test, where the
# database is the compose container and presents no certificate, and on everywhere else,
# which is what a managed server requires. Certificates are verified against Node's CA
# store, so setting this is not a way to accept an unknown one. It exists to override the
# default in a deployed environment; against the compose database the only value that
# connects is off.
#DB_TLS=1

# Owner role — used by the Postgres container and by drizzle-kit for migrations.
POSTGRES_USER=fphd
POSTGRES_PASSWORD=fphd

# Per-API role passwords (role names are fixed: public_api / internal_api).
# Single source of truth: `pnpm db:bootstrap` creates the roles with these, and each
# API connects with them. The internal worker also connects as internal_api, with
# INTERNAL_API_PASSWORD.
PUBLIC_API_PASSWORD=public_api
INTERNAL_API_PASSWORD=internal_api

# How the operations job and the APIs sign in: password (the default) or entra. Deployed
# environments use entra with AZURE_CLIENT_ID; see the README's Configuration section.
#DB_AUTH=password

# Azurite's host port in compose (default 10000); edit the port in STORAGE_CONNECTION_STRING to match.
#AZURITE_PORT=10000

# Uploaded data files: Azurite locally; deployed, STORAGE_ACCOUNT_URL and AZURE_CLIENT_ID instead.
STORAGE_CONTAINER=uploads
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
#STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
#AZURE_CLIENT_ID=<managed identity client id>

# Only for `db import-published-snapshot`: a short-lived private blob URL and
# the SHA-256 of its tar archive. Leave unset for every other operations command.
#PUBLISHED_SNAPSHOT_URL=https://example.blob.core.windows.net/import/snapshot.tar?<sas>
#PUBLISHED_SNAPSHOT_SHA256=<64 lowercase hex characters>

# Only for `db migrate-live-data`: a short-lived private blob URL and the
# SHA-256 of its baseline or incremental tar archive. Leave unset otherwise.
#DATA_MIGRATION_URL=https://example.blob.core.windows.net/import/migration.tar?<sas>
#DATA_MIGRATION_SHA256=<64 lowercase hex characters>
