{
  "name": "find-public-health-data",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.18.0 <12"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "check": "biome check . && pnpm typecheck && pnpm check:migrations && pnpm test && pnpm build && pnpm check:artefacts && pnpm check:e2e-coverage",
    "check:artefacts": "pnpm --filter @fphd/artefact-boundary run check:artefacts",
    "check:e2e-coverage": "pnpm --filter @fphd/e2e-coverage run check:e2e-coverage",
    "check:migrations": "scripts/check-migration-drift.sh",
    "check:perf": "pnpm --filter @fphd/perf run check:perf",
    "check:write": "biome check --write .",
    "db:bootstrap": "pnpm --filter @fphd/operations cli db bootstrap",
    "db:generate": "pnpm --filter \"@fphd/db...\" build && pnpm --filter @fphd/db-operations db:generate",
    "db:import-core-data": "pnpm --filter @fphd/operations cli db import-core-data",
    "db:migrate": "pnpm --filter @fphd/operations cli db migrate",
    "db:rebuild-read-models": "pnpm --filter @fphd/operations cli db rebuild-read-models",
    "db:migrate-live-data": "pnpm --filter @fphd/operations cli db migrate-live-data",
    "db:reset": "pnpm --filter @fphd/operations cli db reset",
    "db:seed-dummy-data": "pnpm --filter @fphd/operations cli db seed-dummy-data",
    "db:studio": "pnpm --filter \"@fphd/db...\" build && pnpm --filter @fphd/db-operations db:studio",
    "dev": "pnpm services:up && pnpm --recursive --parallel run dev",
    "dev:internal": "pnpm services:up && pnpm --parallel --filter @fphd/internal-web --filter @fphd/internal-api run dev",
    "dev:mixed": "scripts/dev.sh",
    "dev:public": "pnpm services:up && pnpm --parallel --filter @fphd/public-web --filter @fphd/public-api run dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "perf:accept": "pnpm --filter @fphd/perf run perf:accept",
    "services:up": "scripts/services.sh",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:e2e": "pnpm --filter @fphd/e2e run test:e2e",
    "test:integration": "cross-env INTEGRATION_DB=1 APP_ENV=test vitest run --passWithNoTests integration.test",
    "test:unit": "vitest run --exclude '**/*integration.test.*' && python3 -m unittest discover -s packages/db-operations/data/seed/export -p 'test_*.py'",
    "typecheck": "pnpm --recursive run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@fphd/db-operations": "workspace:*",
    "@react-router/dev": "catalog:",
    "@types/node": "catalog:",
    "cross-env": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
